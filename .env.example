# ── Postgres (API box) ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-db-password

# ── JWT (API box) ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-access-secret-min-32-chars

# Shared secret required when creating an account (bot gate)
SIGNUP_PASSWORD=change-me-signup-password

# ── SFU join token (API + SFU boxes — must match) ─────────────────────────────
SFU_JOIN_SECRET=change-me-join-secret-min-32-chars

# ── Compositor control plane (API + compositor boxes — must match) ────────────
COMPOSITOR_INTERNAL_SECRET=change-me-compositor-secret-min-32-chars

# ── Public hostnames + Let's Encrypt (DNS-01) ─────────────────────────────────
CERTBOT_EMAIL=kontakt@kaapa.pl

# API / web box
SERVER_NAME=streaming.kaapa.pl
SFU_PUBLIC_WS_URL=wss://sfu.kaapa.pl/ws/signaling
COMPOSITOR_URL=https://compositor.kaapa.pl

# SFU box
SFU_SERVER_NAME=sfu.kaapa.pl
# Elastic IP of the SFU box (ICE candidates must be routable)
MEDIASOUP_ANNOUNCED_IP=13.62.238.146

# Compositor box
COMPOSITOR_SERVER_NAME=compositor.kaapa.pl
COMPOSITOR_POOL_SIZE=2
# Idle warm-session reaper (ms). Lower it to watch slots come back during testing.
COMPOSITOR_WARM_IDLE_MS=600000
# Set to 1 to force GPU passthrough in deploy.sh even if nvidia-smi is missing.
# COMPOSITOR_GPU=1
# ANGLE backend on Linux. Default gl-egl (EGL, no X server). gl = GLX, never works in Docker.
# COMPOSITOR_ANGLE=gl-egl
# 1 = a failed GPU verdict kills the container instead of degrading to CPU.
# COMPOSITOR_GPU_STRICT=1

# ── S3 uploads (API box — optional locally) ───────────────────────────────────
# On EC2: attach an IAM role with s3:PutObject + s3:GetObject on the bucket,
# set region + bucket, and leave access keys unset (SDK uses the instance role).
# Locally / without a role: also set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# AWS_REGION=eu-central-1
# S3_BUCKET=
# S3_PREFIX=recordings
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── YouTube Live Chat OAuth (API box) ─────────────────────────────────────────
# Create a Web OAuth client in Google Cloud; enable YouTube Data API v3.
# Redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://streaming.kaapa.pl/api/platforms/youtube/callback
# WEB_ORIGIN=https://streaming.kaapa.pl
# TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key-min-32

# Facebook / Instagram / LinkedIn / X identity OAuth (API box)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_OAUTH_REDIRECT_URI=https://streaming.kaapa.pl/api/platforms/facebook/callback
# INSTAGRAM_OAUTH_REDIRECT_URI=https://streaming.kaapa.pl/api/platforms/instagram/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_OAUTH_REDIRECT_URI=https://streaming.kaapa.pl/api/platforms/linkedin/callback
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_OAUTH_REDIRECT_URI=https://streaming.kaapa.pl/api/platforms/x/callback
