{
  "name": "streaming",
  "private": true,
  "scripts": {
    "setup": "./scripts/setup-local.sh",
    "dev": "concurrently -n api,sfu,compositor,web -c blue,magenta,yellow,green \"npm run dev --prefix server\" \"npm run dev --prefix sfu\" \"npm run dev --prefix compositor\" \"npm run dev --prefix web\"",
    "dev:api": "npm run dev --prefix server",
    "dev:sfu": "npm run dev --prefix sfu",
    "dev:compositor": "npm run dev --prefix compositor",
    "dev:web": "npm run dev --prefix web",
    "quality-gate": "node scripts/quality-gate.mjs",
    "quality-agent": "node scripts/quality-agent.mjs",
    "plan": "node scripts/plan.mjs",
    "run-issue": "node scripts/coordinator.mjs",
    "swarm": "node scripts/swarm.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
