PORT=3000

DATABASE_URL=postgres://streaming:streaming@localhost:5432/streaming
JWT_SECRET=change-me-access-secret-min-32-chars
# Shared secret required when creating an account (bot gate)
SIGNUP_PASSWORD=change-me-signup-password
SFU_JOIN_SECRET=change-me-join-secret-min-32-chars

# Local compositor service
COMPOSITOR_URL=http://localhost:3002
COMPOSITOR_INTERNAL_SECRET=change-me-min-32-chars

# Optional: direct SFU signaling URL when not path-proxied via web origin.
# Leave unset for local Vite / nginx same-origin /ws/signaling.
# SFU_PUBLIC_WS_URL=wss://sfu.example.com/ws/signaling

# Optional S3 (when unset, stop returns local file path only).
# On EC2 with an IAM instance role: set region + bucket only.
# Locally: also set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# AWS_REGION=eu-central-1
# S3_BUCKET=
# S3_PREFIX=recordings
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
