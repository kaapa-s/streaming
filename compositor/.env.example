PORT=3002
COMPOSITOR_INTERNAL_SECRET=change-me-min-32-chars
COMPOSITOR_POOL_SIZE=1

# Optional: override where Chromium loads the recorder page (Nest serves it).
# COMPOSITOR_PAGE_ORIGIN=http://127.0.0.1:3002

# Recording sink the headless page connects to (same process/container).
# Use loopback — not ws://compositor (Docker DNS → private IP).
RECORDING_SINK_URL=ws://127.0.0.1:3002/ws/recording

# Direct SFU signaling for the headless compositor (required; page is not on the web origin).
# Local: ws://localhost:3001/ws/signaling
# Prod: wss://sfu.example.com/ws/signaling
SFU_PUBLIC_WS_URL=ws://localhost:3001/ws/signaling

# Optional
# FFMPEG_PATH=ffmpeg
# PUPPETEER_EXECUTABLE_PATH=
