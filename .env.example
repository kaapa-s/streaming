# ── Postgres (API box) ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-db-password

# ── JWT (API box) ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-access-secret-min-32-chars

# ── SFU join token (API + SFU boxes — must match) ─────────────────────────────
SFU_JOIN_SECRET=change-me-join-secret-min-32-chars

# ── Compositor control plane (API + compositor boxes — must match) ────────────
COMPOSITOR_INTERNAL_SECRET=change-me-compositor-secret-min-32-chars

# ── Public hostnames + Let's Encrypt (DNS-01) ─────────────────────────────────
CERTBOT_EMAIL=you@example.com

# API / web box
SERVER_NAME=streaming.kaapa.pl
SFU_PUBLIC_WS_URL=wss://sfu.kaapa.pl/ws/signaling
COMPOSITOR_URL=https://compositor.kaapa.pl

# SFU box
SFU_SERVER_NAME=sfu.kaapa.pl
# Elastic IP of the SFU box (ICE candidates must be routable)
MEDIASOUP_ANNOUNCED_IP=203.0.113.42

# Compositor box
COMPOSITOR_SERVER_NAME=compositor.kaapa.pl
# Where Chromium loads the /compositor SPA (public web origin)
COMPOSITOR_WEB_ORIGIN=https://streaming.kaapa.pl
COMPOSITOR_POOL_SIZE=2

# ── S3 uploads (API box — optional locally) ───────────────────────────────────
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PREFIX=recordings
