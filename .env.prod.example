# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-db-password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-access-secret-min-32-chars

# ── SFU join token (HMAC shared secret between API and SFU) ───────────────────
SFU_JOIN_SECRET=change-me-join-secret-min-32-chars

# ── Public hostnames (sslip.io from each box's Elastic IP: dots → dashes) ─────
# API EIP 203.0.113.42 → 203-0-113-42.sslip.io
SERVER_NAME=203-0-113-42.sslip.io
PUBLIC_ORIGIN=https://203-0-113-42.sslip.io
CERTBOT_EMAIL=you@example.com

# SFU box EIP (often different from the API EIP when split)
SFU_SERVER_NAME=203-0-113-42.sslip.io
SFU_PUBLIC_WS_URL=wss://203-0-113-42.sslip.io/ws/signaling

# ── mediasoup (SFU service) ───────────────────────────────────────────────────
# Set to the SFU box Elastic IP so ICE candidates are routable from the internet
MEDIASOUP_ANNOUNCED_IP=203.0.113.42

# Note: WEB_ORIGIN is set to http://web inside docker-compose.prod.yml so the
# headless compositor reaches nginx on the Docker network. Do not override it here.
