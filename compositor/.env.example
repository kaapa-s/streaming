PORT=3002
COMPOSITOR_INTERNAL_SECRET=change-me-min-32-chars
COMPOSITOR_POOL_SIZE=1

# Where the /compositor SPA is served (Vite locally, public web in prod).
WEB_ORIGIN=https://localhost:5173

# Recording sink the headless page connects to (Docker-internal in prod).
# Local default: ws://127.0.0.1:3002/ws/recording
# Prod compose uses ws://compositor:3002/ws/recording — Chromium allows this mixed
# content from HTTPS WEB_ORIGIN via --allow-running-insecure-content.
RECORDING_SINK_URL=ws://127.0.0.1:3002/ws/recording

# Direct SFU signaling for the headless compositor (required when not same-origin).
# Local: leave unset if Vite proxies /ws/signaling; or set ws://localhost:3001/ws/signaling
# SFU_PUBLIC_WS_URL=ws://localhost:3001/ws/signaling

# Optional
# FFMPEG_PATH=ffmpeg
# PUPPETEER_EXECUTABLE_PATH=
