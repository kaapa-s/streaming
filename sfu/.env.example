# SFU box env — use with:
#   docker compose -f docker-compose.prod.yml --env-file sfu/.env --profile sfu up -d sfu sfu-nginx sfu-certbot
#   ./scripts/issue-cert.sh sfu sfu/.env

SFU_JOIN_SECRET=change-me-join-secret-min-32-chars
MEDIASOUP_ANNOUNCED_IP=203.0.113.42

# sslip hostname for this box's EIP (dots → dashes)
SFU_SERVER_NAME=203-0-113-42.sslip.io
CERTBOT_EMAIL=you@example.com
